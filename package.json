    "terser": "5.17.7",
    "element-plus": "2.4.2",
    "mockjs": "1.1.0",
    "dayjs": "1.11.10",
    "js-md5": "0.7.3",
    "mitt": "3.0.1",
    "moment": "2.29.4",
    "nprogress": "0.2.0",
    "pinia": "2.0.28",
    "pinia-plugin-persistedstate": "3.0.1",
    "lodash-es": "4.17.21",
