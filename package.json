    "eslint": "8.45.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-define-config": "1.21.0",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-vue": "9.15.1",
    "husky": "8.0.0",
    "less": "4.1.3",
    "lint-staged": "13.2.3",
    "postcss": "8.3.5",
    "postcss-html": "1.5.0",
    "postcss-less": "6.0.0",
