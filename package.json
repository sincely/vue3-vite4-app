    "svg-sprite-loader": "4.3.0",
    "svgo-loader": "3.0.0",
    "vite-plugin-commonjs": "0.7.1",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-html": "3.2.0",
    "vite-plugin-inspect": "0.7.42",
    "vite-plugin-mock": "2.9.8",
    "vite-plugin-progress": "0.0.7",
