{
  "name": "vue3-vite4-app",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "serve": "vite --mode development",
    "build:test": "vite build --mode test",
    "build:production": "vite build --mode production",
    "preview": "vite preview --port 4173",
    "eslint:fix": "eslint \"src/**/*.{vue,js}\" --fix",
    "lint:fix": "eslint \"src/**/*.{vue,js}\" --fix",
    "prettier:fix": "prettier --write \"src/**/*.{js,vue,less,css,json,html}\"",
    "stylelint:fix": "stylelint \"src/**/*.{vue,css,less,css}\" --fix",
    "bump:patch": "changelogen --bump --output CHANGELOG.md --release --prerelease",
    "bump:minor": "changelogen --bump --output CHANGELOG.md --release --minor",
    "bump:major": "changelogen --bump --output CHANGELOG.md --release --major",
    "dir-tree": "esno ./scripts/dir-tree",
    "lint-staged": "lint-staged",
    "prepare": "husky install"
  },
  "dependencies": {
    "@plugin-web-update-notification/vite": "1.6.6",
    "@vueuse/components": "10.6.1",
    "@vueuse/core": "10.6.1",
    "axios": "1.2.1",
    "terser": "5.26.0",
    "mockjs": "1.1.0",
    "dayjs": "1.11.10",
    "mitt": "3.0.1",
    "moment": "2.29.4",
    "nprogress": "0.2.0",
    "pinia": "2.1.7",
    "pinia-plugin-persistedstate": "3.2.0",
    "lodash-es": "4.17.21",
    "unplugin-auto-import": "0.17.2",
    "unplugin-icons": "0.18.1",
    "unplugin-vue-components": "0.26.0",
    "vite-plugin-commonjs": "0.10.1",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-html": "3.2.0",
    "vite-plugin-inspect": "0.8.1",
    "vite-plugin-mock": "2.9.8",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-svg-loader": "4.0.0",
    "vite-plugin-restart": "0.4.0",
    "vite-plugin-vue-devtools": "0.5.1",
    "vue": "3.3.9",
    "vue-router": "4.2.5"
  },
  "devDependencies": {
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@vitejs/plugin-legacy": "4.1.1",
    "@vitejs/plugin-vue": "4.5.2",
    "autoprefixer": "10.4.14",
    "eslint": "8.54.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-define-config": "2.0.0",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-vue": "9.18.1",
    "husky": "8.0.3",
    "less": "4.1.3",
    "changelogen": "0.5.5",
    "lint-staged": "13.3.0",
    "directory-tree": "3.5.1",
    "treeify": "^1.1.0",
    "esno": "^0.17.0",
    "postcss": "8.3.5",
    "postcss-html": "1.5.0",
    "postcss-less": "6.0.0",
    "prettier": "2.8.8",
    "stylelint": "15.11.0",
    "stylelint-config-html": "1.1.0",
    "stylelint-config-prettier": "9.0.5",
    "stylelint-config-recess-order": "4.4.0",
    "stylelint-config-standard": "34.0.0",
    "stylelint-less": "2.0.0",
    "stylelint-order": "6.0.4",
    "vite": "4.5.1",
    "vue-eslint-parser": "9.3.2"
  }
}
