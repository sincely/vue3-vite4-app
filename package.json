{
  "name": "vue3-vite4-app",
  "private": true,
  "version": "0.0.2",
  "scripts": {
    "serve": "npm run eslint:fix && npm run prettier:fix && npm run stylelint:fix && vite --mode development",
    "build:test": "vite build --mode test",
    "build:production": "vite build --mode production",
    "preview": "vite preview --port 4173",
    "eslint:fix": "eslint \"src/**/*.{vue,js,jsx}\" --fix",
    "lint:fix": "eslint \"src/**/*.{vue,js,jsx}\" --fix",
    "prettier:fix": "prettier --write \"src/**/*.{js,vue}\"",
    "stylelint:fix": "stylelint \"src/**/*.{vue,css,less}\" --fix",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint --config commitlint.config.js -e -V",
    "prepare": "husky install"
  },
  "dependencies": {
    "mockjs": "1.1.0",
    "rollup-plugin-visualizer": "5.9.0",
    "svg-sprite-loader": "4.3.0",
    "svgo-loader": "3.0.0",
    "vite-plugin-commonjs": "0.7.1",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-inspect": "0.7.38",
    "vite-plugin-mock": "2.9.8",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-svg-loader": "4.0.0",
    "vue": "3.2.47",
    "vue-router": "4.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "17.6.5",
    "@commitlint/config-conventional": "17.6.5",
    "@iconify/json": "^2.2.67",
    "@iconify/vue": "^4.1.1",
    "@plugin-web-update-notification/vite": "1.6.5",
    "@vitejs/plugin-legacy": "4.1.1",
    "@vitejs/plugin-vue": "4.2.3",
    "@vueuse/components": "^10.1.0",
    "@vueuse/core": "^10.0.2",
    "autoprefixer": "10.4.14",
    "conventional-changelog-cli": "3.0.0",
    "eslint": "8.45.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-define-config": "1.21.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-vue": "9.15.1",
    "husky": "^8.0.0",
    "less": "4.1.3",
    "lint-staged": "13.2.3",
    "lodash-es": "^4.17.21",
    "postcss": "8.3.5",
    "postcss-html": "1.5.0",
    "postcss-less": "6.0.0",
    "prettier": "2.7.0",
    "stylelint": "15.10.2",
    "stylelint-config-html": "1.1.0",
    "stylelint-config-prettier": "9.0.4",
    "stylelint-config-recess-order": "4.3.0",
    "stylelint-config-standard": "33.0.0",
    "stylelint-less": "1.0.8",
    "stylelint-order": "6.0.3",
    "terser": "5.17.7",
    "unplugin-auto-import": "0.16.6",
    "unplugin-icons": "^0.16.1",
    "unplugin-vue-components": "0.25.1",
    "vite": "4.4.11",
    "vite-plugin-restart": "0.3.1",
    "vite-plugin-vue-devtools": "0.5.1",
    "vite-plugin-vue-images": "0.6.1",
    "vue-eslint-parser": "9.3.1"
  }
}
